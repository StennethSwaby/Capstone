<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Usage examples:
      <xacro:inertial_box mass="0.5" x="0.3" y="0.3" z="0.15">
        <origin xyz="0.15 0 0.075" rpy="0 0 0"/>
      </xacro:inertial_box>

      <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_cylinder>
  -->

  <xacro:macro name="inertial_sphere" params="mass radius *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${(2/5) * mass * (radius*radius)}" ixy="0" ixz="0"
        iyy="${(2/5) * mass * (radius*radius)}" iyz="0"
        izz="${(2/5) * mass * (radius*radius)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="inertial_box" params="mass x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${(1/12) * mass * (y*y + z*z)}" ixy="0" ixz="0"
        iyy="${(1/12) * mass * (x*x + z*z)}" iyz="0"
        izz="${(1/12) * mass * (x*x + y*y)}"/>
    </inertial>
  </xacro:macro>

  <!-- Cylinder aligned with Z axis -->
  <xacro:macro name="inertial_cylinder" params="mass length radius *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${(1/12) * mass * (3*radius*radius + length*length)}" ixy="0" ixz="0"
        iyy="${(1/12) * mass * (3*radius*radius + length*length)}" iyz="0"
        izz="${(1/2)  * mass * (radius*radius)}"/>
    </inertial>
  </xacro:macro>

</robot>
